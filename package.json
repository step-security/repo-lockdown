{
  "name": "repo-lockdown",
  "version": "5.0.2",
  "description": "A GitHub Action that immediately closes and locks issues and pull requests.",
  "author": "step-security",
  "license": "MIT",
  "homepage": "https://github.com/step-security/repo-lockdown#readme",
  "repository": {
    "url": "git+https://github.com/step-security/repo-lockdown.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/step-security/repo-lockdown/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist",
    "update": "ncu --dep prod,dev,peer --filterVersion '^*' --upgrade"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "axios": "^1.21.0",
    "joi": "^18.2.1",
    "lodash.uniqby": "^4.7.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "npm-check-updates": "^22.2.0",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "github",
    "issues",
    "pull requests",
    "lock",
    "close",
    "fork",
    "mirror",
    "automation",
    "github actions",
    "project management",
    "bot"
  ],
  "private": true
}
